{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "description": "Use at least two replicas for stateless active-active availability; durable XA Deployment mode requires exactly one."
    },
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "config": {
      "type": "object",
      "required": ["key", "content"],
      "properties": {
        "existingConfigMap": {"type": "string"},
        "key": {"type": "string", "minLength": 1},
        "content": {"type": "string"}
      }
    },
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1},
    "persistence": {
      "type": "object",
      "required": ["enabled", "accessModes", "size", "mountPath"],
      "properties": {
        "enabled": {"type": "boolean"},
        "existingClaim": {"type": "string"},
        "storageClass": {"type": "string"},
        "accessModes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "size": {"type": "string", "minLength": 1},
        "mountPath": {"type": "string", "pattern": "^/"}
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "ports": {"type": "object"}
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "minAvailable": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "string"}]}
      }
    },
    "networkPolicy": {"type": "object", "properties": {"enabled": {"type": "boolean"}}},
    "serviceMonitor": {"type": "object", "properties": {"enabled": {"type": "boolean"}}}
  }
}
